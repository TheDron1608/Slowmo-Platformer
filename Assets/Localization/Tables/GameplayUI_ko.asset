  - m_Id: 3661487982477312
    m_Localized: "[{ExitButton}]\uC744 \uB20C\uB7EC \uC885\uB8CC"
    m_Metadata:
      m_Items: []
  - m_Id: 72024547951616000
    m_Localized: "[{RestartButton}]\uC744 \uB20C\uB7EC \uB2E4\uC2DC \uC2DC\uC791"
    m_Metadata:
      m_Items: []
  - m_Id: 48618366314979328
    m_Localized: "\uCF64\uBCF4 \uD3EC\uC778\uD2B8"
    m_Metadata:
      m_Items: []
  - m_Id: 49372714548568064
    m_Localized: "\uC218\uC815\uC790\uC758 \uCD1D \uAC00\uACA9"
    m_Metadata:
      m_Items: []
  - m_Id: 49722666810318848
    m_Localized: "\uC601\uAD6C"
    m_Metadata:
      m_Items: []
  - m_Id: 49722677077975040
    m_Localized: "\uAC70\uB798 \uAC00\uB2A5"
    m_Metadata:
      m_Items: []
  - m_Id: 63303765306089472
    m_Localized: "\uC720\uBB3C"
    m_Metadata:
      m_Items: []
  - m_Id: 49739758959828992
    m_Localized: "\uAC00\uACA9"
    m_Metadata:
      m_Items: []
  - m_Id: 63376482126503936
    m_Localized: "\uBC84\uB987 \uC5C6\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 54055963837308928
    m_Localized: "\uC544\uBB34\uAC83\uB3C4 \uC120\uD0DD\uD558\uC9C0 \uC54A\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 54055983223382016
    m_Localized: "\r\uBD80\uC815\uC801\uC778 \uC218\uC2DD\uC5B4 \uD310\uB9E4"
    m_Metadata:
      m_Items: []
  - m_Id: 68906890779926528
    m_Localized: "\uB2E4\uC2DC \uAD74\uB9BC"
    m_Metadata:
      m_Items: []
  - m_Id: 54062699918893056
    m_Localized: "\uD310\uB9E4\uD560 \uC218 \uC788\uB294 \uBD80\uC815\uC801\uC778
      \uC218\uC2DD\uC5B4\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 54062700397043712
    m_Localized: "\r\uC544\uBB34\uAC83\uB3C4 \uAD6C\uB9E4\uD560 \uD3EC\uC778\uD2B8\uAC00
      \uBD80\uC871\uD569\uB2C8\uB2E4. :("
    m_Metadata:
      m_Items: []
  - m_Id: 72162566585966592
    m_Localized: "\uB0A8\uC740 \uCE74\uB4DC \uC218:"
    m_Metadata:
      m_Items: []
  - m_Id: 56582327916273664
    m_Localized: "\uC26C\uC6C0"
    m_Metadata:
      m_Items: []
  - m_Id: 56582328625111040
    m_Localized: "\uC911\uAC04"
    m_Metadata:
      m_Items: []
  - m_Id: 56582329308782592
    m_Localized: "\uC5B4\uB824\uC6C0"
    m_Metadata:
      m_Items: []
  - m_Id: 56582330005037056
    m_Localized: "\uC5B4\uB824\uC6C0"
    m_Metadata:
      m_Items: []
  - m_Id: 56582382328979456
    m_Localized: "\uC0DD\uC874"
    m_Metadata:
      m_Items: []
  - m_Id: 59302068435001344
    m_Localized: "\uB05D"
    m_Metadata:
      m_Items: []
  - m_Id: 68522524361613312
    m_Localized: "\uBE44\uBC00 \uB09C\uC774\uB3C4"
    m_Metadata:
      m_Items: []
  - m_Id: 64521278454996992
    m_Localized: "\uCE90\uB9AD\uD130 \uC7A0\uAE08 \uD574\uC81C\uB428"
    m_Metadata:
      m_Items: []
  - m_Id: 72163102135672832
    m_Localized: "\uC218\uC815\uC790 \uD310\uB9E4"
    m_Metadata:
      m_Items: []
  - m_Id: 72163102932590592
    m_Localized: "\uBD80\uC815\uC801\uC778 \uC218\uC815\uC790\uB97C \uAE0D\uC815\uC801\uC778
      \uC218\uC815\uC790\uB85C \uAD50\uD658\uD558\uC138\uC694.\n\uBD80\uC815\uC801\uC778
      \uC218\uC2DD\uC5B4\uB97C \uC783\uAC8C \uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 72163104094412800
    m_Localized: "\uBD80\uC815\uC801\uC778 \uC218\uC2DD\uC5B4\uB97C \uC5BB\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 72163183916212224
    m_Localized: "\uBBF8\uB798\uC5D0 \uAE0D\uC815\uC801\uC778 \uC218\uC2DD\uC5B4\uB85C
      \uAD50\uD658\uD560 \uC218 \uC788\uB294 \uBD80\uC815\uC801\uC778 \uC218\uC2DD\uC5B4\uB97C
      \uBC1B\uC2B5\uB2C8\uB2E4.\n\uCF64\uBCF4 \uD3EC\uC778\uD2B8\uAC00 \uB192\uC744\uC218\uB85D
      \uB354 \uAC15\uB825\uD55C \uC218\uC815\uC790\uB97C \uCDE8\uD560 \uC218 \uC788\uC73C\uBA70,
      \uCF64\uBCF4 \uD3EC\uC778\uD2B8\uB294 \uD68D\uB4DD \uD6C4 \uC7AC\uC124\uC815\uB429\uB2C8\uB2E4.\n\uB354
      \uB9CE\uC774 \uC218\uC9D1\uD560\uC218\uB85D \uBCF4\uC0C1\uB3C4 \uC88B\uC544\uC9D1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 72163200408215552
    m_Localized: "\uB09C\uC774\uB3C4 \uC0C1\uC2B9"
    m_Metadata:
      m_Items: []
  - m_Id: 72163201205133312
    m_Localized: "\uC2DC\uAC04\uC774 \uC9C0\uB0A8\uC5D0 \uB530\uB77C \uBD80\uC815\uC801\uC778
      \uC218\uC2DD\uC5B4\uB97C \uC5BB\uC2B5\uB2C8\uB2E4. \uB354 \uBC1C\uC804\uD560\uC218\uB85D
      \uB354 \uB9CE\uC740 \uAC83\uC744 \uC5BB\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uC774
      \uC218\uC815\uC790\uB294 \uAD50\uD658\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 102494569475842048
    m_Localized: "\uC0AC\uC7A5"
    m_Metadata:
      m_Items: []
  - m_Id: 101155819684601856
    m_Localized: "\uC2F8\uC6C0"
    m_Metadata:
      m_Items: []
  - m_Id: 101155820791898112
    m_Localized: "\uACC4\uC18D \uB2EC\uB9AC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 101158537031557120
    m_Localized: "\uC774\uBC88\uC5D0\uB294 \uC655\uC88C\uAC00 \uC774\uBBF8 \uCC28\uC9C0\uB418\uC5B4
      \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 101158596888469504
    m_Localized: "\uB124 \uC2B9\uB9AC\uB294 \uC544\uBB34\uB7F0 \uC758\uBBF8\uAC00
      \uC5C6\uB2E4. \uB124 \uAE38\uC744 \uACC4\uC18D \uAC00\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 101163715331858432
    m_Localized: "\uB204\uAC00 \uC774\uAE30\uB4E0 \uC0C1\uAD00\uC5C6\uC2B5\uB2C8\uB2E4.
      \uB2F9\uC2E0\uC740 \uB2F9\uC2E0\uACFC \uB611\uAC19\uC740 \uC0AC\uB78C\uC73C\uB85C
      \uB300\uCCB4\uB420 \uD14C\uB2C8\uAE4C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 101163874170150912
    m_Localized: "\uC5EC\uAE30\uC11C \uB9C8\uBB34\uB9AC\uD560 \uC900\uBE44\uAC00
      \uB418\uC168\uB098\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 101164813740384256
    m_Localized: "\uC62C \uB54C\uB9C8\uB2E4 \uC774\uACF3\uC5D0 \uC624\uAE30\uAC00
      \uB354 \uC218\uC6D4\uD574\uC9C0\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 101165298845196288
    m_Localized: "\uB0B4\uAC00 \uBC14\uB85C \uBCF4\uC2A4\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 101168209063026688
    m_Localized: "\uC804\uD22C \uC900\uBE44\uAC00 \uB418\uC168\uC2B5\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 101168266906673152
    m_Localized: "\uC548\uB155"
    m_Metadata:
      m_Items: []
  - m_Id: 102282851697008640
    m_Localized: "\uB2F9\uC2E0\uC758 \uC55E\uAE38\uC744 \uB9C9\uC9C0 \uC54A\uACA0\uC2B5\uB2C8\uB2E4.
      \uAC00\uB358 \uAE38\uC744 \uACC4\uC18D \uAC00\uC2ED\uC2DC\uC624."
    m_Metadata:
      m_Items: []
  - m_Id: 102283085059694592
    m_Localized: "\uC774\uAC8C \uB0B4 \uB9C8\uC9C0\uB9C9\uC778\uAC00? \uC815\uB9D0
      \uC5EC\uAE30\uC11C \uBAA8\uB4E0 \uAC8C \uB05D\uB098\uB294 \uAC78\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 102283180568190976
    m_Localized: "\uC5EC\uC815\uC744 \uACC4\uC18D\uD558\uAC70\uB098, \uC8FD\uC74C\uC744
      \uAC01\uC624\uD558\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 102284126853505024
    m_Localized: "\uB2F9\uC2E0 \uAC19\uC740 \uC120\uC218\uAC00 \uC5B4\uB5BB\uAC8C
      \uADF8\uB807\uAC8C \uC77C\uCC0D \uC774\uACF3\uC5D0 \uC62C \uC218 \uC788\uC5C8\uB098\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 102284146726117376
    m_Localized: "\uC2E4\uB825 \uBB38\uC81C"
    m_Metadata:
      m_Items: []
  - m_Id: 102284159569076224
    m_Localized: "\uC2B9\uB9AC\uAC00 \uC815\uB9D0 \uCF54\uC55E\uC774\uC5C8\uB294\uB370,
      \uCC38 \uC544\uC27D\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 102284747052654592
    m_Localized: "\uC5EC\uAE30\uAE4C\uC9C0 \uC628 \uC0AC\uB78C\uC774\uB77C\uBA74
      \uB354 \uB098\uC740 \uBAA8\uC2B5\uC744 \uBCF4\uC5EC\uC904 \uAC83\uC774\uB77C
      \uAE30\uB300\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 102284934462545920
    m_Localized: "\uADF8\uB7F0 \uB9DD\uC2E0\uC744 \uB2F9\uD560 \uC904\uC740 \uBAB0\uB790\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 102285540124237824
    m_Localized: "\uC81C \uB9D0\uC740 \uC774\uBBF8 \uB4E4\uC73C\uC168\uC744 \uD14C\uB2C8,
      \uBC14\uB85C \uBCF8\uB860\uC73C\uB85C \uB4E4\uC5B4\uAC00\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 102285615076450304
    m_Localized: "\uADF8\uB9AC\uACE0 \uB610\uB2E4\uC2DC \uC5EC\uAE30 \uACC4\uC2DC\uAD70\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 102285662212038656
    m_Localized: "\uC815\uB9D0 \uB9CE\uC774 \uC131\uC7A5\uD558\uC168\uB124\uC694.
      \uC778\uC0C1\uC801\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 102285943851163648
    m_Localized: "\uB2E4\uC2DC \uC624\uC2E0 \uAC83\uC744 \uD658\uC601\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 102286015238217728
    m_Localized: "\uB9D0\uC774 \uC548 \uB3FC\uC694. \uB9C8\uC9C0\uB9C9\uC5D0 \uB2F9\uC2E0\uC744
      \uAE30\uB2E4\uB9AC\uB294 \uBCF4\uC0C1 \uAC19\uC740 \uAC74 \uC5C6\uC73C\uB2C8\uAE4C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 103543018010943488
    m_Localized: "\uACE0\uB9AC"
    m_Metadata:
      m_Items: []
  - m_Id: 104419232492544000
    m_Localized: "\uC0C8\uB85C\uC6B4 \uB8E8\uD504"
    m_Metadata:
      m_Items: []
  - m_Id: 104419233209769984
    m_Localized: "\uC6B8\uD2B8\uB77C \uBAA8\uB514\uD30C\uC774\uC5B4\uB97C \uD68D\uB4DD\uD558\uACE0,
      \uD604\uC7AC \uC801\uC6A9 \uC911\uC778 \uBAA8\uB4E0 \uBAA8\uB514\uD30C\uC774\uC5B4\uB97C
      \uC720\uC9C0\uD55C \uCC44 \uAC8C\uC784\uC744 \uB2E4\uC2DC \uC2DC\uC791\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
