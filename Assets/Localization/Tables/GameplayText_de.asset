  m_TableData:
  - m_Id: 5406695424
    m_Localized: Bewegen
    m_Metadata:
      m_Items: []
  - m_Id: 7130554368
    m_Localized: Springen
    m_Metadata:
      m_Items: []
  - m_Id: 9286426624
    m_Localized: Angreifen
    m_Metadata:
      m_Items: []
  - m_Id: 14206345216
    m_Localized: Interagieren
    m_Metadata:
      m_Items: []
  - m_Id: 27481317376
    m_Localized: Greifen/Werfen
    m_Metadata:
      m_Items: []
  - m_Id: 28043354112
    m_Localized: 'Rollen '
    m_Metadata:
      m_Items: []
  - m_Id: 21693710516346880
    m_Localized: "Halten Sie gedr\xFCckt, um h\xF6her zu springen\n\nDr\xFCcken Sie
      zweimal, um einen Doppelsprung durchzuf\xFChren"
    m_Metadata:
      m_Items: []
  - m_Id: 21719977978486784
    m_Localized: "Ohne Waffe kann man nicht angreifen\n\n\nNehmen Sie die Pistole
      und t\xF6ten Sie den Feind, um fortzufahren"
    m_Metadata:
      m_Items: []
  - m_Id: 21722062933450752
    m_Localized: "Werfen Sie den Schl\xFCssel in die T\xFCr, um fortzufahren"
    m_Metadata:
      m_Items: []
  - m_Id: 21722205636255744
    m_Localized: Schlagen Sie den Feind mit einem Wurf nieder, um fortzufahren
    m_Metadata:
      m_Items: []
  - m_Id: 23552175786418176
    m_Localized: "Besondere F\xE4higkeit"
    m_Metadata:
      m_Items: []
  - m_Id: 23552505035087872
    m_Localized: "Mit der Spezialf\xE4higkeit k\xF6nnen Sie Ihre Waffe auf den R\xFCcken
      legen oder abnehmen.\nDie Spezialf\xE4higkeit kann sich im Verlauf des Spiels
      \xE4ndern."
    m_Metadata:
      m_Items: []
  - m_Id: 23552266043645952
    m_Localized: "Trage deine Waffe auf den R\xFCcken, um fortzufahren."
    m_Metadata:
      m_Items: []
  - m_Id: 21722610667610112
    m_Localized: "T\xF6te Feinde, um Combopunkte zu erhalten\n\n\nSp\xE4ter k\xF6nnen
      Combopunkte gegen Modifikatoren eingetauscht werden\n\n\nErreichen Sie die
      rote T\xFCr und t\xF6ten Sie dabei so viele Feinde wie m\xF6glich"
    m_Metadata:
      m_Items: []
  - m_Id: 21763017808011264
    m_Localized: "Sie haben einen negativen Modifikator erhalten; Um es gegen ein
      n\xFCtzliches einzutauschen, trage es zur gr\xFCnen T\xFCr"
    m_Metadata:
      m_Items: []
  - m_Id: 21763598907858944
    m_Localized: "Das Spiel wird alle 3 Minuten schwieriger, sodass Sie Modifikatoren
      ausw\xE4hlen m\xFCssen, die nicht ausgetauscht werden k\xF6nnen.\nSie m\xFCssen
      15 Minuten \xFCberleben. Sie k\xF6nnen Ihren Fortschritt in der linken Ecke
      verfolgen. W\xE4hrend des Tutorials ist die Zeit eingefroren."
    m_Metadata:
      m_Items: []
  - m_Id: 21764450431262720
    m_Localized: "Sie k\xF6nnen Informationen zu aktuellen Modifikatoren anzeigen,
      indem Sie das Spiel pausieren\n\n\n\xD6ffnen Sie das Pausenmen\xFC und bewegen
      Sie den Mauszeiger \xFCber das Modifikatorsymbol, um fortzufahren"
    m_Metadata:
      m_Items: []
  - m_Id: 24219064862760960
    m_Localized: "Rollsprung\n\nSie k\xF6nnen w\xE4hrend einer Rolle springen, was
      zu einer erheblichen Geschwindigkeitssteigerung f\xFChrt"
    m_Metadata:
      m_Items: []
  - m_Id: 21765088586227712
    m_Localized: 'Ausbildung abgeschlossen


      Nimm die Teleporter-Granate und
      aktiviere sie, um dich ins echte Spiel zu teleportieren :)'
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
