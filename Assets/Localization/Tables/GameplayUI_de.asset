  - m_Id: 57840205824
    m_Localized: tot
    m_Metadata:
      m_Items: []
  - m_Id: 1363553899216896
    m_Localized: Pause
    m_Metadata:
      m_Items: []
  - m_Id: 1363770899922944
    m_Localized: Fortsetzen
    m_Metadata:
      m_Items: []
  - m_Id: 1363818505273344
    m_Localized: Optionen
    m_Metadata:
      m_Items: []
  - m_Id: 1364207313059840
    m_Localized: Beenden
    m_Metadata:
      m_Items: []
  - m_Id: 1364247855202304
    m_Localized: Sind Sie sicher?
    m_Metadata:
      m_Items: []
  - m_Id: 3660322389590016
    m_Localized: Du bist tot
    m_Metadata:
      m_Items: []
  - m_Id: 57112601552986112
    m_Localized: Du gewinnst
    m_Metadata:
      m_Items: []
  - m_Id: 3660413980606464
    m_Localized: "\xDCberlebte Zeit:"
    m_Metadata:
      m_Items: []
  - m_Id: 3661153759363072
    m_Localized: "Erhaltene Fl\xFCche:"
    m_Metadata:
      m_Items: []
  - m_Id: 3661285078827008
    m_Localized: "Get\xF6tet:"
    m_Metadata:
      m_Items: []
  - m_Id: 3661487982477312
    m_Localized: "Dr\xFCcken Sie [{ExitButton}], um zu beenden"
    m_Metadata:
      m_Items: []
  - m_Id: 72024547951616000
    m_Localized: "Dr\xFCcken Sie [{RestartButton}], um neu zu starten"
    m_Metadata:
      m_Items: []
  - m_Id: 48618366314979328
    m_Localized: Combo-Punkte
    m_Metadata:
      m_Items: []
  - m_Id: 49372714548568064
    m_Localized: Gesamtpreis der Modifikatoren
    m_Metadata:
      m_Items: []
  - m_Id: 49722666810318848
    m_Localized: Permanent
    m_Metadata:
      m_Items: []
  - m_Id: 49722677077975040
    m_Localized: Handelbar
    m_Metadata:
      m_Items: []
  - m_Id: 63303765306089472
    m_Localized: Artefakt
    m_Metadata:
      m_Items: []
  - m_Id: 49739758959828992
    m_Localized: Preis
    m_Metadata:
      m_Items: []
  - m_Id: 63376482126503936
    m_Localized: Verdorben
    m_Metadata:
      m_Items: []
  - m_Id: 54055963837308928
    m_Localized: "Nichts ausw\xE4hlen"
    m_Metadata:
      m_Items: []
  - m_Id: 54055983223382016
    m_Localized: "\rNegative Modifikatoren verkaufen"
    m_Metadata:
      m_Items: []
  - m_Id: 68906890779926528
    m_Localized: "Erneut w\xFCrfeln"
    m_Metadata:
      m_Items: []
  - m_Id: 54062699918893056
    m_Localized: Sie haben keine handelbaren negativen Modifikatoren zum Verkaufen
    m_Metadata:
      m_Items: []
  - m_Id: 54062700397043712
    m_Localized: "\rNicht genug Punkte, um etwas zu kaufen :("
    m_Metadata:
      m_Items: []
  - m_Id: 72162566585966592
    m_Localized: 'Verbleibende Karten:'
    m_Metadata:
      m_Items: []
  - m_Id: 56582327916273664
    m_Localized: Einfach
    m_Metadata:
      m_Items: []
  - m_Id: 56582328625111040
    m_Localized: Mittel
    m_Metadata:
      m_Items: []
  - m_Id: 56582329308782592
    m_Localized: Schwer
    m_Metadata:
      m_Items: []
  - m_Id: 56582330005037056
    m_Localized: Schwer
    m_Metadata:
      m_Items: []
  - m_Id: 56582382328979456
    m_Localized: "\xDCberleben"
    m_Metadata:
      m_Items: []
  - m_Id: 59302068435001344
    m_Localized: Ende
    m_Metadata:
      m_Items: []
  - m_Id: 68522524361613312
    m_Localized: GEHEIME SCHWIERIGKEIT
    m_Metadata:
      m_Items: []
  - m_Id: 64521278454996992
    m_Localized: Charakter freigeschaltet
    m_Metadata:
      m_Items: []
  - m_Id: 72163102135672832
    m_Localized: Modifikatoren verkaufen
    m_Metadata:
      m_Items: []
  - m_Id: 72163102932590592
    m_Localized: 'Tauschen Sie Ihre negativen Modifikatoren gegen positive aus.

      Sie
      verlieren Ihre negativen Modifikatoren.'
    m_Metadata:
      m_Items: []
  - m_Id: 72163104094412800
    m_Localized: Erhalten Sie einen negativen Modifikator.
    m_Metadata:
      m_Items: []
  - m_Id: 72163183916212224
    m_Localized: "Erhalten Sie einen negativen Modifikator, der in Zukunft gegen
      einen positiven Modifikator eingetauscht werden kann.\nJe h\xF6her Ihre Combo-Punkte,
      desto st\xE4rkere Modifikatoren k\xF6nnen Sie nehmen. Combo-Punkte werden nach
      der Einnahme zur\xFCckgesetzt.\nJe mehr Sie sammeln, desto besser ist die Belohnung."
    m_Metadata:
      m_Items: []
  - m_Id: 72163200408215552
    m_Localized: Schwierigkeitsgrad steigt
    m_Metadata:
      m_Items: []
  - m_Id: 72163201205133312
    m_Localized: "Du erh\xE4ltst mit der Zeit negative Modifikatoren; Je weiter Sie
      voranschreiten, desto mehr davon erhalten Sie.\nDiese Modifikatoren k\xF6nnen
      nicht ausgetauscht werden. "
    m_Metadata:
      m_Items: []
  - m_Id: 101155819684601856
    m_Localized: "K\xE4mpfen"
    m_Metadata:
      m_Items: []
  - m_Id: 101155820791898112
    m_Localized: Setzen Sie den Lauf fort.
    m_Metadata:
      m_Items: []
  - m_Id: 101158537031557120
    m_Localized: Diesmal ist der Thron bereits besetzt.
    m_Metadata:
      m_Items: []
  - m_Id: 101158596888469504
    m_Localized: Dein Sieg bedeutet nichts. Geh deinen Weg weiter.
    m_Metadata:
      m_Items: []
  - m_Id: 101163715331858432
    m_Localized: Es spielt keine Rolle, wer gewinnt. Du wirst durch jemanden ersetzt,
      der genau so ist wie du.
    m_Metadata:
      m_Items: []
  - m_Id: 101163874170150912
    m_Localized: "Sind Sie bereit, hier aufzuh\xF6ren?"
    m_Metadata:
      m_Items: []
  - m_Id: 101164813740384256
    m_Localized: "Es f\xE4llt dir jedes Mal leichter, hierherzukommen."
    m_Metadata:
      m_Items: []
  - m_Id: 101165298845196288
    m_Localized: Ich bin der Chef.
    m_Metadata:
      m_Items: []
  - m_Id: 101168209063026688
    m_Localized: "Bist du bereit f\xFCr den Kampf?"
    m_Metadata:
      m_Items: []
  - m_Id: 101168266906673152
    m_Localized: Hallo
    m_Metadata:
      m_Items: []
  - m_Id: 102282851697008640
    m_Localized: Ich werde dir nicht im Weg stehen. Geh deinen Weg weiter.
    m_Metadata:
      m_Items: []
  - m_Id: 102283085059694592
    m_Localized: "Ist das das Ende f\xFCr mich? Geht hier wirklich alles zu Ende?"
    m_Metadata:
      m_Items: []
  - m_Id: 102283180568190976
    m_Localized: Setze die Reise fort oder bereite dich auf den Tod vor.
    m_Metadata:
      m_Items: []
  - m_Id: 102284126853505024
    m_Localized: "Wie hat es ein Spieler wie du geschafft, schon fr\xFCher hierher
      zu kommen?"
    m_Metadata:
      m_Items: []
  - m_Id: 102284146726117376
    m_Localized: "Mangelndes K\xF6nnen"
    m_Metadata:
      m_Items: []
  - m_Id: 102284159569076224
    m_Localized: Du warst so nah am Sieg. Wie schade.
    m_Metadata:
      m_Items: []
  - m_Id: 102284747052654592
    m_Localized: Ich habe mehr von jemandem erwartet, der es so weit gebracht hat.
    m_Metadata:
      m_Items: []
  - m_Id: 102284934462545920
    m_Localized: Ich hatte eine solche Schande nicht erwartet.
    m_Metadata:
      m_Items: []
  - m_Id: 102285540124237824
    m_Localized: "Sie haben mich ja schon geh\xF6rt. Kommen wir direkt zum Punkt."
    m_Metadata:
      m_Items: []
  - m_Id: 102285615076450304
    m_Localized: Und da bist du wieder.
    m_Metadata:
      m_Items: []
  - m_Id: 102285662212038656
    m_Localized: "Du hast wirklich einen weiten Weg zur\xFCckgelegt. Beeindruckend."
    m_Metadata:
      m_Items: []
  - m_Id: 102285943851163648
    m_Localized: "Willkommen zur\xFCck"
    m_Metadata:
      m_Items: []
  - m_Id: 102286015238217728
    m_Localized: Es ergibt keinen Sinn. Am Ende wartet kein Preis auf dich.
    m_Metadata:
      m_Items: []
  - m_Id: 103543018010943488
    m_Localized: Schleife
    m_Metadata:
      m_Items: []
  - m_Id: 104419232492544000
    m_Localized: Neue Schleife
    m_Metadata:
      m_Items: []
  - m_Id: 104419233209769984
    m_Localized: "Hol dir den Ultra-Modifikator und starte das Spiel neu, w\xE4hrend
      du alle deine aktuellen Modifikatoren beh\xE4ltst."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
