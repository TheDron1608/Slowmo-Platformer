  - m_Id: 68522524361613312
    m_Localized: GEHEIME SCHWIERIGKEIT
    m_Metadata:
      m_Items: []
  - m_Id: 64521278454996992
    m_Localized: Charakter freigeschaltet
    m_Metadata:
      m_Items: []
  - m_Id: 72163102135672832
    m_Localized: Modifikatoren verkaufen
    m_Metadata:
      m_Items: []
  - m_Id: 72163102932590592
    m_Localized: 'Tauschen Sie Ihre negativen Modifikatoren gegen positive aus.

      Sie
      verlieren Ihre negativen Modifikatoren.'
    m_Metadata:
      m_Items: []
  - m_Id: 72163104094412800
    m_Localized: Erhalten Sie einen negativen Modifikator.
    m_Metadata:
      m_Items: []
  - m_Id: 72163183916212224
    m_Localized: "Erhalten Sie einen negativen Modifikator, der in Zukunft gegen
      einen positiven Modifikator eingetauscht werden kann.\nJe h\xF6her Ihre Combo-Punkte,
      desto st\xE4rkere Modifikatoren k\xF6nnen Sie nehmen. Combo-Punkte werden nach
      der Einnahme zur\xFCckgesetzt.\nJe mehr Sie sammeln, desto besser ist die Belohnung."
    m_Metadata:
      m_Items: []
  - m_Id: 72163200408215552
    m_Localized: Schwierigkeitsgrad steigt
    m_Metadata:
      m_Items: []
  - m_Id: 72163201205133312
    m_Localized: "Du erh\xE4ltst mit der Zeit negative Modifikatoren; Je weiter Sie
      voranschreiten, desto mehr davon erhalten Sie.\nDiese Modifikatoren k\xF6nnen
      nicht ausgetauscht werden. "
    m_Metadata:
      m_Items: []
