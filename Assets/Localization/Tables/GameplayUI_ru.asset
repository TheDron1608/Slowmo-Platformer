  - m_Id: 63376482126503936
    m_Localized: "\u0418\u0441\u043F\u043E\u0440\u0447\u0435\u043D\u043E \u043D\u0430 "
    m_Metadata:
      m_Items: []
  - m_Id: 64521278454996992
    m_Localized: "\u041E\u0442\u043A\u0440\u044B\u0442 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436"
    m_Metadata:
      m_Items: []
  - m_Id: 68522524361613312
    m_Localized: "\u0421\u0415\u041A\u0420\u0415\u0422\u041D\u0410\u042F \u0421\u041B\u041E\u0416\u041D\u041E\u0421\u0422\u042C"
    m_Metadata:
      m_Items: []
  - m_Id: 68906890779926528
    m_Localized: "\u041F\u0435\u0440\u0435\u0431\u0440\u043E\u0441\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 72024547951616000
    m_Localized: "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 [{RestartButton}] \u0447\u0442\u043E\u0431\u044B
      \u043D\u0430\u0447\u0430\u0442\u044C \u0437\u0430\u043D\u043E\u0432\u043E"
    m_Metadata:
      m_Items:
      - rid: 3223126429313007718
  - m_Id: 72162566585966592
    m_Localized: "\u041E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u043A\u0430\u0440\u0442: "
    m_Metadata:
      m_Items: []
  - m_Id: 72163102135672832
    m_Localized: "\u041F\u0440\u043E\u0434\u0430\u0436\u0430 \u043C\u043E\u0434\u0438\u0444\u0438\u043A\u0430\u0442\u043E\u0440\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 72163102932590592
    m_Localized: "\u041E\u0431\u043C\u0435\u043D\u044F\u0439\u0442\u0435 \u0432\u0430\u0448\u0438
      \u043D\u0435\u0433\u0430\u0442\u0438\u0432\u043D\u044B\u0435 \u043C\u043E\u0434\u0438\u0444\u0438\u043A\u0430\u0442\u043E\u0440\u044B,
      \u043D\u0430 \u043F\u043E\u043B\u043E\u0436\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435.\n\u0412\u044B
      \u043F\u043E\u0442\u0435\u0440\u044F\u0435\u0442\u0435 \u043D\u0435\u0433\u0430\u0442\u0438\u0432\u043D\u044B\u0435
      \u043C\u043E\u0434\u0438\u0444\u0438\u043A\u0430\u0442\u043E\u0440\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 72163104094412800
    m_Localized: "\u0412\u044B\u0434\u0430\u0447\u0430 \u043D\u0435\u0433\u0430\u0442\u0438\u0432\u043D\u043E\u0433\u043E
      \u043C\u043E\u0434\u0438\u0444\u0438\u043A\u0430\u0442\u043E\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 72163183916212224
    m_Localized: "\u041F\u043E\u043B\u0443\u0447\u0438\u0442\u0435 \u043D\u0435\u0433\u0430\u0442\u0438\u0432\u043D\u044B\u0439
      \u043C\u043E\u0434\u0438\u0444\u0438\u043A\u0430\u0442\u043E\u0440, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u0432 \u0431\u0443\u0434\u0443\u0449\u0435\u043C \u043C\u043E\u0436\u043D\u043E
      \u043E\u0431\u043C\u0435\u043D\u044F\u0442\u044C \u043D\u0430 \u043F\u043E\u043B\u043E\u0436\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u043C\u043E\u0434\u0438\u0444\u0438\u043A\u0442\u0430\u043E\u0440.\n\u0427\u0435\u043C
      \u0431\u043E\u043B\u044C\u0448\u0435 \u0432\u044B \u0441\u043E\u0431\u0435\u0440\u0435\u0442\u0435,
      \u0442\u0435\u043C \u043B\u0443\u0447\u0448\u0435 \u043D\u0430\u0433\u0440\u0430\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 72163200408215552
    m_Localized: "\u041F\u043E\u0432\u044B\u0448\u0435\u043D\u0438\u0435 \u0441\u043B\u043E\u0436\u043D\u043E\u0441\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 72163201205133312
    m_Localized: "\u0412\u044B \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442\u0435
      \u043D\u0435\u0433\u0430\u0442\u0438\u0432\u043D\u044B\u0435 \u043C\u043E\u0434\u0438\u0444\u0438\u043A\u0430\u0442\u043E\u0440\u044B
      \u0441\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C, \u0447\u0435\u043C
      \u0434\u0430\u043B\u044C\u0448\u0435 \u0432\u044B \u0434\u043E\u0448\u043B\u0438,
      \u0442\u0435\u043C \u0431\u043E\u043B\u044C\u0448\u0435 \u0438\u0445 \u0431\u0443\u0434\u0435\u0442.\n\u042D\u0442\u0438
      \u043C\u043E\u0434\u0438\u0444\u0438\u043A\u0430\u0442\u043E\u0440\u044B \u043D\u0435\u043B\u044C\u0437\u044F
      \u043E\u0431\u043C\u0435\u043D\u044F\u0442\u044C."
    m_Metadata:
      m_Items: []
