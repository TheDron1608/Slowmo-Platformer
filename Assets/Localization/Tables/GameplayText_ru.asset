    m_Localized: "\u0414\u0432\u0438\u0436\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 7130554368
    m_Localized: "\u041F\u0440\u044B\u0436\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 9286426624
    m_Localized: "\u0410\u0442\u0430\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 14206345216
    m_Localized: "\u0412\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 27481317376
    m_Localized: "\u0412\u0437\u044F\u0442\u044C/\u0411\u0440\u043E\u0441\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 28043354112
    m_Localized: "\u041F\u0435\u0440\u0435\u043A\u0430\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 21693710516346880
    m_Localized: "\u0423\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435
      \u0434\u043B\u044F \u0431\u043E\u043B\u0435\u0435 \u0432\u044B\u0441\u043E\u043A\u043E\u0433\u043E
      \u043F\u0440\u044B\u0436\u043A\u0430\n\n\u041D\u0430\u0436\u043C\u0438\u0442\u0435
      \u0434\u0432\u0430\u0436\u0434\u044B \u0434\u043B\u044F \u0434\u0432\u043E\u0439\u043D\u043E\u0433\u043E
      \u043F\u0440\u044B\u0436\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 21719977978486784
    m_Localized: "\u0411\u0435\u0437 \u043E\u0440\u0443\u0436\u0438\u044F \u0442\u044B
      \u043D\u0435 \u043C\u043E\u0436\u0435\u0448\u044C \u0430\u0442\u0430\u043A\u043E\u0432\u0430\u0442\u044C\n\n\u0412\u043E\u0437\u044C\u043C\u0438
      \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442 \u0438 \u0443\u0431\u0435\u0439
      \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430 \u0434\u043B\u044F
      \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0435\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 21722062933450752
    m_Localized: "\u041A\u0438\u043D\u044C\u0442\u0435 \u043A\u043B\u044E\u0447 \u0432
      \u0434\u0432\u0435\u0440\u044C, \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 21722205636255744
    m_Localized: "\u0421\u0431\u0435\u0439 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430
      \u0441 \u043D\u043E\u0433 \u043F\u0435\u0440\u0435\u043A\u0430\u0442\u043E\u043C
      \u0434\u043B\u044F \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0435\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 21722610667610112
    m_Localized: "\u0423\u0431\u0438\u0432\u0430\u0439 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u043E\u0432,
      \u0447\u0442\u043E\u0431\u044B \u043D\u0430\u0431\u0440\u0430\u0442\u044C \u043E\u0447\u043A\u0438
      \u043A\u043E\u043C\u0431\u043E\n\n\u0412 \u0434\u0430\u043B\u044C\u043D\u0435\u0439\u0448\u0435\u043C
      \u043E\u0447\u043A\u0438 \u043A\u043E\u043C\u0431\u043E \u043C\u043E\u0436\u043D\u043E
      \u0431\u0443\u0434\u0435\u0442 \u043E\u0431\u043C\u0435\u043D\u044F\u0442\u044C
      \u043D\u0430 \u043C\u043E\u0434\u0438\u0444\u0438\u043A\u0430\u0442\u043E\u0440\u044B\n\n\u0414\u043E\u0439\u0434\u0438
      \u0434\u043E \u043A\u0440\u0430\u0441\u043D\u043E\u0439 \u0434\u0432\u0435\u0440\u0438,
      \u0443\u0431\u0438\u0432 \u043A\u0430\u043A \u043C\u043E\u0436\u043D\u043E
      \u0431\u043E\u043B\u044C\u0448\u0435 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u043E\u0432
      \u043F\u043E \u043F\u0443\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 21763017808011264
    m_Localized: "\u0422\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u043D\u0435\u0433\u0430\u0442\u0438\u0432\u043D\u044B\u0439
      \u043C\u043E\u0434\u0438\u0444\u0438\u043A\u0430\u0442\u043E\u0440, \u0447\u0442\u043E\u0431\u044B
      \u043E\u0431\u043C\u0435\u043D\u044F\u0442\u044C \u0435\u0433\u043E \u043D\u0430
      \u043C\u043E\u0434\u0438\u0444\u0438\u043A\u0430\u0442\u043E\u0440, \u0434\u0430\u044E\u0449\u0438\u0439
      \u043F\u043E\u043B\u044C\u0437\u0443, \u0434\u043E\u0439\u0434\u0438 \u0441
      \u043D\u0438\u043C \u0434\u043E \u0437\u0435\u043B\u0451\u043D\u043E\u0439
      \u0434\u0432\u0435\u0440\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 21763598907858944
    m_Localized: "\u0418\u0433\u0440\u0430 \u0431\u0443\u0434\u0435\u0442 \u0443\u0441\u043B\u043E\u0436\u043D\u044F\u0442\u044C\u0441\u044F
      \u043A\u0430\u0436\u0434\u044B\u0435 3 \u043C\u0438\u043D\u0443\u0442\u044B,
      \u0437\u0430\u0441\u0442\u0430\u0432\u043B\u044F\u044F \u0442\u0435\u0431\u044F
      \u0432\u044B\u0431\u0438\u0440\u0430\u0442\u044C \u043C\u043E\u0434\u0438\u0444\u0438\u043A\u0430\u0442\u043E\u0440\u044B,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043D\u0435\u043B\u044C\u0437\u044F
      \u043E\u0431\u043C\u0435\u043D\u044F\u0442\u044C.\n\u0422\u0435\u0431\u0435
      \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E \u043F\u0440\u043E\u0434\u0435\u0440\u0436\u0430\u0442\u044C\u0441\u044F
      15 \u043C\u0438\u043D\u0443\u0442. \u041F\u0440\u043E\u0433\u0440\u0435\u0441\u0441
      \u0438\u0433\u0440\u044B \u043C\u043E\u0436\u043D\u043E \u0443\u0432\u0438\u0434\u0435\u0442\u044C
      \u0432 \u043B\u0435\u0432\u043E\u043C \u0443\u0433\u043B\u0443, \u0432 \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u0438
      \u0432\u0440\u0435\u043C\u044F \u0437\u0430\u043C\u043E\u0440\u043E\u0436\u0435\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 21764450431262720
    m_Localized: "\u0422\u044B \u043C\u043E\u0436\u0435\u0448\u044C \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E \u043E \u0442\u0435\u043A\u0443\u0449\u0438\u0445
      \u043C\u043E\u0434\u0438\u0444\u0438\u043A\u0430\u0442\u043E\u0440\u0430\u0445,
      \u043D\u0430\u0436\u0430\u0432 \u043D\u0430 \u043F\u0430\u0443\u0437\u0443\n\n\u041E\u0442\u043A\u0440\u043E\u0439
      \u043F\u0430\u0443\u0437\u0443 \u0438 \u043D\u0430\u0432\u0435\u0434\u0438\u0441\u044C
      \u043D\u0430 \u0438\u043A\u043E\u043D\u043A\u0443 \u043C\u043E\u0434\u0438\u0444\u0438\u043A\u0430\u0442\u043E\u0440\u0430,
      \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 21765088586227712
    m_Localized: "\u041E\u0431\u0443\u0447\u0435\u043D\u0438\u0435 \u043F\u0440\u043E\u0439\u0434\u0435\u043D\u043E\n\n\u0412\u043E\u0437\u044C\u043C\u0438
      \u0442\u0435\u043B\u0435\u043F\u043E\u0440\u0442 \u0433\u0440\u0430\u043D\u0430\u0442\u0443
      \u0438 \u0430\u043A\u0442\u0438\u0432\u0438\u0440\u0443\u0439 \u0435\u0451,
      \u0447\u0442\u043E\u0431\u044B \u043E\u043D\u0430 \u0442\u0435\u043B\u0435\u043F\u043E\u0440\u0442\u0438\u0440\u043E\u0432\u0430\u043B\u0430
      \u0442\u0435\u0431\u044F \u0432 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0443\u044E
      \u0438\u0433\u0440\u0443 :)"
    m_Metadata:
      m_Items: []
  - m_Id: 23552175786418176
    m_Localized: "\u0421\u043F\u0435\u0446. \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 23552505035087872
    m_Localized: "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435
      \u0441\u043F\u0435\u0446. \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438
      \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u0432\u0430\u043C \u043F\u043E\u0432\u0435\u0441\u0438\u0442\u044C
      \u0438\u043B\u0438 \u0441\u043D\u044F\u0442\u044C \u043E\u0440\u0443\u0436\u0438\u0435
      \u0441\u043E \u0441\u043F\u0438\u043D\u044B. \n\u0421\u043F\u0435\u0446. \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C
      \u043C\u043E\u0436\u0435\u0442 \u043C\u0435\u043D\u044F\u0442\u044C\u0441\u044F
      \u043F\u043E \u0445\u043E\u0434\u0443 \u0438\u0433\u0440\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 23552266043645952
    m_Localized: "\u041F\u043E\u0432\u0435\u0441\u044C\u0442\u0435 \u043E\u0440\u0443\u0436\u0438\u0435
      \u043D\u0430 \u0441\u043F\u0438\u043D\u0443, \u0447\u0442\u043E\u0431\u044B
      \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 24219064862760960
    m_Localized: "\u041F\u0440\u044B\u0436\u043E\u043A \u0432 \u043F\u0435\u0440\u0435\u043A\u0430\u0442\u0435\n\n\u0422\u044B
      \u043C\u043E\u0436\u0435\u0448\u044C \u043F\u0440\u044B\u0433\u0430\u0442\u044C
      \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u043F\u0435\u0440\u0435\u043A\u0430\u0442\u0430,
      \u0447\u0442\u043E \u0434\u0430\u0441\u0442 \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435
      \u0443\u0441\u043A\u043E\u0440\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
