    m_Localized: "\u30CD\u30AC\u30C6\u30A3\u30D6\u306A\u30E2\u30C7\u30A3\u30D5\u30A1\u30A4\u30A2\u3092\u30DD\u30B8\u30C6\u30A3\u30D6\u306A\u30E2\u30C7\u30A3\u30D5\u30A1\u30A4\u30A2\u306B\u4EA4\u63DB\u3057\u307E\u3059\u3002\n\u30DE\u30A4\u30CA\u30B9\u306E\u4FEE\u98FE\u5B50\u306F\u5931\u308F\u308C\u307E\u3059\u3002"
