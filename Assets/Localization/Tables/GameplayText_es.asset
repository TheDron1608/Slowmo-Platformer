  m_TableData:
  - m_Id: 5406695424
    m_Localized: Mover
    m_Metadata:
      m_Items: []
  - m_Id: 7130554368
    m_Localized: Saltar
    m_Metadata:
      m_Items: []
  - m_Id: 9286426624
    m_Localized: Atacar
    m_Metadata:
      m_Items: []
  - m_Id: 14206345216
    m_Localized: Interactuar
    m_Metadata:
      m_Items: []
  - m_Id: 27481317376
    m_Localized: Agarrar/Lanzar
    m_Metadata:
      m_Items: []
  - m_Id: 28043354112
    m_Localized: 'Rodar '
    m_Metadata:
      m_Items: []
  - m_Id: 21693710516346880
    m_Localized: "Mant\xE9n presionado para saltar m\xE1s alto\n\nPulsa dos veces
      para hacer doble salto."
    m_Metadata:
      m_Items: []
  - m_Id: 21719977978486784
    m_Localized: 'No puedes atacar sin un arma.



      Coge la pistola y mata al
      enemigo para continuar.'
    m_Metadata:
      m_Items: []
  - m_Id: 21722062933450752
    m_Localized: Tira la llave a la puerta para continuar.
    m_Metadata:
      m_Items: []
  - m_Id: 21722205636255744
    m_Localized: Derriba al enemigo con una tirada para continuar.
    m_Metadata:
      m_Items: []
  - m_Id: 23552175786418176
    m_Localized: habilidad especial
    m_Metadata:
      m_Items: []
  - m_Id: 23552505035087872
    m_Localized: "Usar la habilidad especial te permite colgarte el arma en la espalda
      o quit\xE1rtela.\nLa habilidad especial puede cambiar a medida que avanza el
      juego."
    m_Metadata:
      m_Items: []
  - m_Id: 23552266043645952
    m_Localized: "Col\xF3cate el arma en la espalda para continuar."
    m_Metadata:
      m_Items: []
  - m_Id: 21722610667610112
    m_Localized: "Mata enemigos para ganar puntos combinados.\n\n\nM\xE1s adelante,
      los puntos combinados se pueden canjear por modificadores.\n\n\nLlega a la
      puerta roja mientras matas a tantos enemigos como puedas en el camino."
    m_Metadata:
      m_Items: []
  - m_Id: 21763017808011264
    m_Localized: "Ha recibido un modificador negativo; para cambiarlo por uno beneficioso,
      ll\xE9valo hasta la puerta verde"
    m_Metadata:
      m_Items: []
  - m_Id: 21763598907858944
    m_Localized: "El juego se volver\xE1 m\xE1s dif\xEDcil cada 3 minutos, lo que
      te obligar\xE1 a elegir modificadores que no se pueden intercambiar.\nNecesitas
      sobrevivir durante 15 minutos. Puedes seguir tu progreso en la esquina izquierda.
      El tiempo se congela durante el tutorial."
    m_Metadata:
      m_Items: []
  - m_Id: 21764450431262720
    m_Localized: "Puedes ver informaci\xF3n sobre los modificadores actuales pausando
      el juego.\n\n\nAbra el men\xFA de pausa y coloque el cursor sobre el \xEDcono
      modificador para continuar"
    m_Metadata:
      m_Items: []
  - m_Id: 24219064862760960
    m_Localized: "salto rodante\n\nPuedes saltar durante una tirada, lo que proporcionar\xE1
      un aumento significativo de velocidad."
    m_Metadata:
      m_Items: []
  - m_Id: 21765088586227712
    m_Localized: "Entrenamiento completo\n\nRecoge la granada teletransportadora
      y act\xEDvala para teletransportarte al juego real :)"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
