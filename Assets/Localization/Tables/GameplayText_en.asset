  m_TableData:
  - m_Id: 5406695424
    m_Localized: Move
    m_Metadata:
      m_Items: []
  - m_Id: 7130554368
    m_Localized: Jump
    m_Metadata:
      m_Items: []
  - m_Id: 9286426624
    m_Localized: Attack
    m_Metadata:
      m_Items: []
  - m_Id: 14206345216
    m_Localized: Interact
    m_Metadata:
      m_Items: []
  - m_Id: 27481317376
    m_Localized: Grab/Throw
    m_Metadata:
      m_Items: []
  - m_Id: 28043354112
    m_Localized: Roll
    m_Metadata:
      m_Items: []
  - m_Id: 21693710516346880
    m_Localized: 'Hold to jump higher


      Press twice to double jump'
    m_Metadata:
      m_Items: []
  - m_Id: 21719977978486784
    m_Localized: 'You cannot attack without a weapon



      Pick up the pistol
      and kill the enemy to continue'
    m_Metadata:
      m_Items: []
  - m_Id: 21722062933450752
    m_Localized: Throw the key into the door to continue
    m_Metadata:
      m_Items: []
  - m_Id: 21722205636255744
    m_Localized: Knock the enemy down with a roll to continue
    m_Metadata:
      m_Items:
      - rid: 569246335167889514
  - m_Id: 21722610667610112
    m_Localized: 'Kill enemies to earn combo points



      Later on, combo points
      can be exchanged for modifiers



      Reach the red door while killing as
      many enemies as possible along the way'
    m_Metadata:
      m_Items: []
  - m_Id: 21763017808011264
    m_Localized: You have received a negative modifier; to exchange it for a beneficial
      one, carry it to the green door
    m_Metadata:
      m_Items: []
  - m_Id: 21763598907858944
    m_Localized: 'The game will get harder every 3 minutes, forcing you to choose
      modifiers that cannot be swapped.

      You need to survive for 15 minutes.
      You can track your progress in the left corner. Time is frozen during the tutorial.'
    m_Metadata:
      m_Items: []
  - m_Id: 21764450431262720
    m_Localized: 'You can view information about current modifiers by pausing the
      game



      Open the pause menu and hover over the modifier icon to continue'
    m_Metadata:
      m_Items: []
  - m_Id: 21765088586227712
    m_Localized: 'Training complete



      Pick up the teleporter grenade and activate
      it to teleport into the game'
    m_Metadata:
      m_Items: []
  - m_Id: 23552175786418176
    m_Localized: Special ability
    m_Metadata:
      m_Items: []
  - m_Id: 23552505035087872
    m_Localized: 'Using the special ability allows you to sling your weapon onto
      your back or take it off.

      The special ability may change as the game
      progresses.'
    m_Metadata:
      m_Items: []
  - m_Id: 23552266043645952
    m_Localized: Sling your weapon on your back to continue.
    m_Metadata:
      m_Items: []
