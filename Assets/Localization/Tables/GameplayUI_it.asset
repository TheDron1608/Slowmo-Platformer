  - m_Id: 68522524361613312
    m_Localized: "DIFFICOLT\xC0 SEGRETA"
    m_Metadata:
      m_Items: []
  - m_Id: 64521278454996992
    m_Localized: Personaggio sbloccato
    m_Metadata:
      m_Items: []
  - m_Id: 72163102135672832
    m_Localized: Modificatori di vendita
    m_Metadata:
      m_Items: []
  - m_Id: 72163102932590592
    m_Localized: 'Scambia i tuoi modificatori negativi con quelli positivi.

      Perderai
      i tuoi modificatori negativi.'
    m_Metadata:
      m_Items: []
  - m_Id: 72163104094412800
    m_Localized: Ottieni un modificatore negativo
    m_Metadata:
      m_Items: []
  - m_Id: 72163183916212224
    m_Localized: "Ricevi un modificatore negativo che pu\xF2 essere scambiato con
      un modificatore positivo in futuro.\nPi\xF9 alti sono i tuoi punti combo, pi\xF9
      potenti modificatori puoi prendere, i punti combo verranno ripristinati dopo
      averli presi.\nPi\xF9 raccogli, migliore sar\xE0 la ricompensa."
    m_Metadata:
      m_Items: []
  - m_Id: 72163200408215552
    m_Localized: "Aumento della difficolt\xE0"
    m_Metadata:
      m_Items: []
  - m_Id: 72163201205133312
    m_Localized: "Ottieni modificatori negativi nel tempo; pi\xF9 avanzi, pi\xF9
      ne guadagni.\nQuesti modificatori non possono essere scambiati. "
    m_Metadata:
      m_Items: []
