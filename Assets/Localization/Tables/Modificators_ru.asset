    m_Localized: "* \u041F\u0440\u0438 \u043F\u0440\u043E\u0434\u0430\u0436\u0435
      \u0432\u044B \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442 \u0432 2 \u0440\u0430\u0437\u0430
      \u0431\u043E\u043B\u044C\u0448\u0435 \u043F\u0435\u0440\u043C\u0430\u043D\u0435\u043D\u0442\u043D\u044B\u0445
