      - rid: 8344437339716845657
  - m_Id: 21756670900412416
    m_Localized: "\r* An immortal enemy appears on the level\r\n* The enemy always
      knows your location\r\n* The enemy is hostile to everyone, but only targets
      you"
    m_Metadata:
      m_Items: []
  - m_Id: 22093576976703488
    m_Localized: Teleportation
    m_Metadata:
      m_Items: []
  - m_Id: 22093587466657792
    m_Localized: Deadly teleportation
    m_Metadata:
      m_Items: []
  - m_Id: 22093579119992832
    m_Localized: '* You can teleport

      * Teleport costs {HealthCost} health'
    m_Metadata:
      m_Items:
      - rid: 8344437339716845657
  - m_Id: 22093589144379392
    m_Localized: "* You can teleport to enemies, instantly killing them\n\r* Teleport
      costs {ComboCost} combo and {HealthCost} health"
    m_Metadata:
      m_Items:
      - rid: 8344437339716845657
  - m_Id: 24054089340133376
    m_Localized: Buckshot pocket weapon
    m_Metadata:
      m_Items: []
  - m_Id: 24054090220937216
    m_Localized: "\r* All pocket-sized weapons fire buckshot"
    m_Metadata:
      m_Items: []
  - m_Id: 24054158000889856
    m_Localized: Piercing pocket weapon
    m_Metadata:
      m_Items: []
  - m_Id: 24054158814584832
    m_Localized: "\r* All pocket-sized weapons fire piercing rounds"
    m_Metadata:
      m_Items: []
  - m_Id: 24063745018011648
    m_Localized: Smart pocket weapon
    m_Metadata:
      m_Items: []
  - m_Id: 24063746167250944
    m_Localized: '* All pocket-sized weapons fire homing rounds'
    m_Metadata:
      m_Items: []
  - m_Id: 24063835027775488
    m_Localized: Buckshot assault weapon
    m_Metadata:
      m_Items: []
  - m_Id: 24063836567085056
    m_Localized: '* All medium-sized weapons fire buckshot'
    m_Metadata:
      m_Items: []
  - m_Id: 24063837250756608
    m_Localized: Piercing assault weapon
    m_Metadata:
      m_Items: []
  - m_Id: 24063840107077632
    m_Localized: '* All medium-sized weapons fire piercing rounds'
    m_Metadata:
      m_Items: []
  - m_Id: 24063840803332096
    m_Localized: Smart assault weapon
    m_Metadata:
      m_Items: []
  - m_Id: 24063841487003648
    m_Localized: '* All medium-sized weapons fire homing rounds'
    m_Metadata:
      m_Items: []
  - m_Id: 24063842174869504
    m_Localized: Buckshot heavy weapon
    m_Metadata:
      m_Items: []
  - m_Id: 24063846436282368
    m_Localized: Piercing heavy weapon
    m_Metadata:
      m_Items: []
  - m_Id: 24064415464923136
    m_Localized: Smart heavy weapon
    m_Metadata:
      m_Items: []
  - m_Id: 24063842787237888
    m_Localized: '* All large-sized weapons fire buckshot'
    m_Metadata:
      m_Items: []
  - m_Id: 24064413762035712
    m_Localized: '* All large-sized weapons fire piercing rounds'
    m_Metadata:
      m_Items: []
  - m_Id: 24064663721582592
    m_Localized: '* All large-sized weapons fire homing rounds'
    m_Metadata:
      m_Items: []
  - m_Id: 24323621510160384
    m_Localized: Random ammo
    m_Metadata:
      m_Items: []
  - m_Id: 24323622126723072
    m_Localized: '* All ranged weapons are loaded with random ammo'
    m_Metadata:
      m_Items: []
  - m_Id: 24335004465340416
    m_Localized: Firearm melee
    m_Metadata:
      m_Items: []
  - m_Id: 24335005354532864
    m_Localized: "\r* Melee weapons fire random bullets"
    m_Metadata:
      m_Items: []
  - m_Id: 24335870777860096
    m_Localized: Melee firearm
    m_Metadata:
      m_Items: []
  - m_Id: 24335872010985472
    m_Localized: "\r* Firearms attack with random melee attacks"
    m_Metadata:
      m_Items: []
  - m_Id: 24336960512565248
    m_Localized: Chaos ammo
    m_Metadata:
      m_Items: []
  - m_Id: 24336963117228032
    m_Localized: "\r* All weapons attack with random projectiles"
    m_Metadata:
      m_Items: []
  - m_Id: 24460306264858624
    m_Localized: Random ranged
    m_Metadata:
      m_Items: []
  - m_Id: 24460362007158784
    m_Localized: Random melee
    m_Metadata:
      m_Items: []
  - m_Id: 24460307254714368
    m_Localized: '* Firearms are loaded with random ammo'
    m_Metadata:
      m_Items: []
  - m_Id: 24460363051540480
    m_Localized: "\r* Melee weapons attack with random melee attacks"
    m_Metadata:
      m_Items: []
  - m_Id: 25665323839406080
    m_Localized: More loot
    m_Metadata:
      m_Items: []
  - m_Id: 25665525669314560
    m_Localized: Weapons warehouse
    m_Metadata:
      m_Items: []
  - m_Id: 25665484967788544
    m_Localized: Armory
    m_Metadata:
      m_Items: []
  - m_Id: 25665325080920064
    m_Localized: "\r* Crates contain loot inside\r\n* Lockers contain more items"
    m_Metadata:
      m_Items: []
  - m_Id: 25665485739540480
    m_Localized: "\r\r* Crates contain loot inside\n* Lockers and crates contain
      more items\r\n* Lockers and crates can contain stronger weapons"
    m_Metadata:
      m_Items: []
  - m_Id: 25665526340403200
    m_Localized: "\r* Any furniture can contain loot inside\r\n* Furniture can contain
      significantly more powerful weapons"
    m_Metadata:
      m_Items: []
  - m_Id: 27742279511023616
    m_Localized: Combo Speed
    m_Metadata:
      m_Items: []
  - m_Id: 27742280165335040
    m_Localized: '* The higher the combo, the higher speed'
    m_Metadata:
      m_Items: []
  - m_Id: 27909262747607040
    m_Localized: Addiction
    m_Metadata:
      m_Items: []
  - m_Id: 27909263364169728
    m_Localized: '* Combo increases restore {ComboRegen} health

      * Combo reset
      deals {ComboDamage} health per kill'
    m_Metadata:
      m_Items:
      - rid: 8344437339716845657
  - m_Id: 28086521643114496
    m_Localized: Combo damage
    m_Metadata:
      m_Items: []
  - m_Id: 28086525128581120
    m_Localized: '* The higher the combo, the higher damage'
    m_Metadata:
      m_Items: []
  - m_Id: 28092185329246208
    m_Localized: Doomed
    m_Metadata:
      m_Items: []
  - m_Id: 28092185828368384
    m_Localized: '* You will die in 5 minutes'
    m_Metadata:
      m_Items: []
  - m_Id: 29070670252187648
    m_Localized: Adrenaline overdose
    m_Metadata:
      m_Items: []
  - m_Id: 29070670940053504
    m_Localized: "* The less health, the higher the speed\n\r* Time slows down as
      the speed increases"
    m_Metadata:
      m_Items:
      - rid: 8344437339716845657
  - m_Id: 29086115118161920
    m_Localized: SpeedLoader
    m_Metadata:
      m_Items: []
  - m_Id: 29086117039153152
    m_Localized: "\r* All non-magazine weapons reload significantly faster"
    m_Metadata:
      m_Items: []
  - m_Id: 29157579976581120
    m_Localized: Kill streak
    m_Metadata:
      m_Items: []
  - m_Id: 29157582866456576
    m_Localized: '* Weapon attack delay resets on kill'
    m_Metadata:
      m_Items: []
  - m_Id: 29158216529321984
    m_Localized: Counter attack
    m_Metadata:
      m_Items: []
  - m_Id: 29158217246547968
    m_Localized: '* Weapon attack delay is reset when blocking a projectile'
    m_Metadata:
      m_Items: []
  - m_Id: 29179763398778880
    m_Localized: Broken legs
    m_Metadata:
      m_Items: []
  - m_Id: 29179766724861952
    m_Localized: Broken hands
    m_Metadata:
      m_Items: []
  - m_Id: 29179768280948736
    m_Localized: Severe injuries
    m_Metadata:
      m_Items: []
  - m_Id: 29179769136586752
    m_Localized: "\r* You perform any actions with a delay\r\n* You must be stationary
      to perform an action"
    m_Metadata:
      m_Items: []
  - m_Id: 29179767429505024
    m_Localized: "\r* You attack with a delay\r\n* You must remain motionless while
      attacking"
    m_Metadata:
      m_Items: []
  - m_Id: 29179764682235904
    m_Localized: "\r* You move and jump with a delay\r\n* You are stationary while
      you initiate a jump"
    m_Metadata:
      m_Items: []
  - m_Id: 29405274624466944
    m_Localized: "\rArm fracture"
    m_Metadata:
      m_Items: []
  - m_Id: 29405276113444864
    m_Localized: '* You are immobile while reloading'
    m_Metadata:
      m_Items: []
  - m_Id: 32071464828248064
    m_Localized: Correct houses
    m_Metadata:
      m_Items: []
  - m_Id: 32071465750994944
    m_Localized: "\r* Buildings are fully completed\r\n* Levels are more linear"
    m_Metadata:
      m_Items: []
  - m_Id: 32071527616978944
    m_Localized: Unfinished construction
    m_Metadata:
      m_Items: []
  - m_Id: 32071529198231552
    m_Localized: "\r* Level generation has significantly more open spaces and chasms"
    m_Metadata:
      m_Items: []
  - m_Id: 32071586312069120
    m_Localized: Strange world
    m_Metadata:
      m_Items: []
  - m_Id: 32071587054460928
    m_Localized: '* World generation is significally changed'
    m_Metadata:
      m_Items: []
  - m_Id: 32641407600795648
    m_Localized: "\r* The world generation consists of small houses on the surface"
    m_Metadata:
      m_Items: []
  - m_Id: 32641406954872832
    m_Localized: Deurbanization
    m_Metadata:
      m_Items: []
  - m_Id: 34414475566358528
    m_Localized: "\r* Enemy health x{HealthUp}%"
    m_Metadata:
      m_Items:
      - rid: 8344437339716845657
  - m_Id: 34414359396720640
    m_Localized: '* Enemy health x{HealthUp}%'
    m_Metadata:
      m_Items:
      - rid: 8344437339716845657
  - m_Id: 34414355374383104
    m_Localized: '* Enemy health x{HealthUp}%'
    m_Metadata:
      m_Items:
      - rid: 8344437339716845657
  - m_Id: 34414353809907712
    m_Localized: Health up
    m_Metadata:
      m_Items: []
  - m_Id: 34414358390087680
    m_Localized: Tank
    m_Metadata:
      m_Items: []
  - m_Id: 34414360814395392
    m_Localized: Juggernaut
    m_Metadata:
      m_Items: []
  - m_Id: 37026845560119296
    m_Localized: Peacemaker
    m_Metadata:
      m_Items: []
  - m_Id: 37026846214430720
    m_Localized: "\r* Breaking or unloading a weapon heals {HealAmount} health"
    m_Metadata:
      m_Items:
      - rid: 8344437339716845657
  - m_Id: 37496867369754624
    m_Localized: No mercy
    m_Metadata:
      m_Items: []
  - m_Id: 37496869680816128
    m_Localized: Unconventional fencing techniques
    m_Metadata:
      m_Items: []
  - m_Id: 37496868418330624
    m_Localized: "\r* Using a special ability finishes off the nearest knocked down
      enemy"
    m_Metadata:
      m_Items: []
  - m_Id: 37496870809083904
    m_Localized: '* Using a special ability finishes off the nearest knocked-down
      enemy

      * Finishing off kills any enemy, ignoring armor and immortality'
    m_Metadata:
      m_Items: []
  - m_Id: 38580360967331840
    m_Localized: "* Enemy speed \u200B\u200Bx{SpeedUpPrecent}%\r\n* Enemy jump height
      x{JumpForcePrecent}%"
    m_Metadata:
      m_Items:
      - rid: 8344437339716845657
  - m_Id: 38580374561071104
    m_Localized: "* Enemy speed \u200B\u200Bx{SpeedUpPrecent}%\r\n* Enemy jump height
      x{JumpForcePrecent}%"
    m_Metadata:
      m_Items:
      - rid: 8344437339716845657
  - m_Id: 38580377199288320
    m_Localized: "* Enemy speed \u200B\u200Bx{SpeedUpPrecent}%\r\n* Enemy jump height
      x{JumpForcePrecent}%"
    m_Metadata:
      m_Items:
      - rid: 8344437339716845657
  - m_Id: 38580375433486336
    m_Localized: "\rEvil hedgehog"
    m_Metadata:
      m_Items: []
  - m_Id: 38580362003324928
    m_Localized: Sprinters
    m_Metadata:
      m_Items: []
  - m_Id: 38580359654514688
    m_Localized: Fast enemies
    m_Metadata:
      m_Items: []
  - m_Id: 47608481125212160
    m_Localized: Kickboxing
    m_Metadata:
      m_Items: []
  - m_Id: 47608482991677440
    m_Localized: "\r* The player can kick the enemy when not holding a weapon"
    m_Metadata:
      m_Items: []
  - m_Id: 48287512308981760
    m_Localized: "\r* You receive a sword at the start\r\n* Using an ability converts
      the enemy closest to the sword to your side\r\n* Using an ability costs {ConvertCost}
      combo\r\n* Converted characters cannot live longer than {ConvertLiveTime} and
      will die if they are too far from the sword"
    m_Metadata:
      m_Items:
      - rid: 8344437339716845657
  - m_Id: 48287511650476032
    m_Localized: "\rSword cult"
    m_Metadata:
      m_Items: []
  - m_Id: 48719723764097024
    m_Localized: Vigor
    m_Metadata:
      m_Items: []
  - m_Id: 48719724397436928
    m_Localized: "\r* Combo halves instead of reset (decreases by 1 if less than
      0)\r\n* Combo reset speed x{ResetComboMultiplier}\r\n* You die if your combo
      drops to {MinCombo}"
    m_Metadata:
      m_Items:
      - rid: 8344437339716845657
  - m_Id: 48728468984406016
    m_Localized: Dodging master
    m_Metadata:
      m_Items: []
  - m_Id: 48728469554831360
    m_Localized: '* You reflect any projectiles as long as your combo is above 0

      *
      Reflecting a projectile costs {DodgeComboCost} combo'
    m_Metadata:
      m_Items:
      - rid: 8344437339716845657
  - m_Id: 48730691038584832
    m_Localized: Glass
    m_Metadata:
      m_Items: []
  - m_Id: 48730691650953216
    m_Localized: '* One hit and you''re dead'
    m_Metadata:
      m_Items: []
  - m_Id: 49010918759309312
    m_Localized: Absolutely nothing
    m_Metadata:
      m_Items: []
  - m_Id: 49010920923570176
    m_Localized: "\r* You cannot obtain and sell modifiers\r\n* You still receive
      permanent modifiers over time"
    m_Metadata:
      m_Items: []
  - m_Id: 49275710807973888
    m_Localized: Collector
    m_Metadata:
      m_Items: []
  - m_Id: 49275715270713344
    m_Localized: "\r* Using this ability will grant you a negative modifier with
      the \"Artifact\" status.\r\n* The higher the combo, the more expensive the
      artifact.\r\n* Artifacts heal you; the healing increases based on the cost
      and decreases passively over time.\r\n* You can collect up to {ModificatorCapacity}
      artifacts. Exceeding the limit will replace the last artifact with a new one."
    m_Metadata:
      m_Items:
      - rid: 8344437339716845657
  - m_Id: 49627624955420672
    m_Localized: Decay
    m_Metadata:
      m_Items: []
  - m_Id: 49627625479708672
    m_Localized: '* Maximum health is unlimited

      * You lose {HealthLossPrecent}%
      of your current health per second'
    m_Metadata:
      m_Items:
      - rid: 8344437339716845657
  - m_Id: 53781888334274560
    m_Localized: Patience
    m_Metadata:
      m_Items: []
  - m_Id: 53781889047306240
    m_Localized: "\r* You can't sell modifiers until you increase the difficulty"
    m_Metadata:
      m_Items: []
  - m_Id: 53788989446135808
    m_Localized: Shuffle
    m_Metadata:
      m_Items: []
  - m_Id: 53788989945257984
    m_Localized: '* All modifiers are replaced with random ones with the same price'
    m_Metadata:
      m_Items: []
  - m_Id: 54179387779817472
    m_Localized: '* All modifiers are replaced with their harder version if they
      have one'
    m_Metadata:
      m_Items: []
  - m_Id: 54179387003871232
    m_Localized: Evolution
    m_Metadata:
      m_Items: []
  - m_Id: 54347527729946624
    m_Localized: To the moon
    m_Metadata:
      m_Items: []
  - m_Id: 54347528380063744
    m_Localized: "\r* You receive significantly stronger tradable negative modifiers"
    m_Metadata:
      m_Items: []
  - m_Id: 54358641960263680
    m_Localized: Stagnation
    m_Metadata:
      m_Items: []
  - m_Id: 54358642643935232
    m_Localized: '* Selling negative modifiers is {ProfitMult}% more profitable.

      *
      After selling negative modifiers, they become permanent.'
    m_Metadata:
      m_Items:
      - rid: 8344437339716845657
  - m_Id: 54416059155062784
    m_Localized: Retcon
    m_Metadata:
      m_Items: []
  - m_Id: 54416059800985600
    m_Localized: '* You instantly move to the next difficulty'
    m_Metadata:
      m_Items: []
  - m_Id: 54531334339551232
    m_Localized: New game+
    m_Metadata:
      m_Items: []
  - m_Id: 54531335073554432
    m_Localized: '* You start the game over, keeping all modifiers'
    m_Metadata:
      m_Items: []
  - m_Id: 54700080565035008
    m_Localized: Chaos card
    m_Metadata:
      m_Items: []
  - m_Id: 54700081269678080
    m_Localized: '* At the end of the level, 1 modifier is replaced with a random
      one with an identical price'
    m_Metadata:
      m_Items: []
  - m_Id: 54751871461728256
    m_Localized: '* The game gets more difficult at double speed'
    m_Metadata:
      m_Items: []
  - m_Id: 54751870618673152
    m_Localized: Speedrun
    m_Metadata:
      m_Items: []
  - m_Id: 54902326812712960
    m_Localized: Second chance
    m_Metadata:
      m_Items: []
  - m_Id: 54902327492190208
    m_Localized: "\r* You can reroll modifiers {AddRerolls} times when choosing them"
    m_Metadata:
      m_Items:
      - rid: 8344437339716845657
  - m_Id: 55067746236604416
    m_Localized: Curse of the God of Random
    m_Metadata:
      m_Items: []
  - m_Id: 55067746991579136
    m_Localized: '* You cannot skip the selection of tradable negative modifiers'
    m_Metadata:
      m_Items: []
  - m_Id: 55102672239566848
    m_Localized: Game changer
    m_Metadata:
      m_Items: []
  - m_Id: 55102630434938880
    m_Localized: "\rPermanent hypercompensation"
    m_Metadata:
      m_Items: []
  - m_Id: 55102522020569088
    m_Localized: Hypercompensation
    m_Metadata:
      m_Items: []
  - m_Id: 55102522700046336
    m_Localized: "\r* You get double amount of negative modifiers sold, but you also
      get a positive modifier equal to half the total price"
    m_Metadata:
      m_Items: []
  - m_Id: 55102631420600320
    m_Localized: "\r* When selling, you receive 2 times more permanent positive modifiers,
      but you also receive a negative modifier equal to half the total price"
    m_Metadata:
      m_Items: []
  - m_Id: 55102672889683968
    m_Localized: '* You get {AddModsPercent} more modifiers, but you also get modifiers
      of the opposite type equal to half the total cost'
    m_Metadata:
      m_Items:
      - rid: 8344437339716845657
  - m_Id: 55615535613976576
    m_Localized: Double the bet
    m_Metadata:
      m_Items: []
  - m_Id: 55615536234733568
    m_Localized: '* Duplicates all tradable modifiers if they can be duplicated'
    m_Metadata:
      m_Items: []
  - m_Id: 55627909834186752
    m_Localized: Chaos
    m_Metadata:
      m_Items: []
  - m_Id: 55627910698213376
    m_Localized: "\r* Gain {GainAmount} random neutral modifiers"
    m_Metadata:
      m_Items:
      - rid: 8344437339716845657
