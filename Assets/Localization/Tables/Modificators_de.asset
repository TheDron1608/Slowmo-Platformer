      m_Items: []
  - m_Id: 29179763398778880
    m_Localized: Gebrochene Beine
    m_Metadata:
      m_Items: []
  - m_Id: 29179764682235904
    m_Localized: "* Sie bewegen und springen mit einer Verz\xF6gerung\r\n* Sie stehen
      still, w\xE4hrend Sie einen Sprung einleiten"
    m_Metadata:
      m_Items: []
  - m_Id: 29179766724861952
    m_Localized: "Gebrochene H\xE4nde"
    m_Metadata:
      m_Items: []
  - m_Id: 29179767429505024
    m_Localized: "* Du greifst mit Verz\xF6gerung an\r\n* Sie m\xFCssen beim Angriff
      bewegungslos bleiben"
    m_Metadata:
      m_Items: []
  - m_Id: 29179768280948736
    m_Localized: Schwere Verletzungen
    m_Metadata:
      m_Items: []
  - m_Id: 29179769136586752
    m_Localized: "* Sie f\xFChren alle Aktionen mit Verz\xF6gerung aus\r\n* Sie m\xFCssen
      station\xE4r sein, um eine Aktion ausf\xFChren zu k\xF6nnen"
