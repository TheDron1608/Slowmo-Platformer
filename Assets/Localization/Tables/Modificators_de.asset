  - m_Id: 37496867369754624
    m_Localized: Keine Gnade
    m_Metadata:
      m_Items: []
  - m_Id: 37496868418330624
    m_Localized: "* Der Einsatz einer Spezialf\xE4higkeit erledigt den n\xE4chsten
      niedergeschlagenen Gegner"
    m_Metadata:
      m_Items: []
  - m_Id: 37496869680816128
    m_Localized: Unkonventionelle Fechttechniken
    m_Metadata:
      m_Items: []
  - m_Id: 37496870809083904
    m_Localized: "* Der Einsatz einer Spezialf\xE4higkeit erledigt den n\xE4chsten
      niedergeschlagenen Feind\n* Durch das Erledigen wird jeder Feind get\xF6tet,
      R\xFCstung und Unsterblichkeit werden ignoriert"
    m_Metadata:
      m_Items: []
