      - rid: 569246017750564865
  - m_Id: 3075468056821760
    m_Localized: Vampirismus
    m_Metadata:
      m_Items: []
  - m_Id: 3074307899752448
    m_Localized: "* Stellt {VampirismStealPercent} % der Gesundheit get\xF6teter
      Charaktere wieder her"
    m_Metadata:
      m_Items:
      - rid: 569246017750564865
  - m_Id: 10133043029098496
    m_Localized: "Verz\xF6gerter Tod"
    m_Metadata:
      m_Items: []
  - m_Id: 10133461012463616
    m_Localized: "* Der Spieler stirbt nicht, nachdem er {ToughLifetime} Sekunden
      lang t\xF6dlichen Schaden erlitten hat"
    m_Metadata:
      m_Items:
      - rid: 569246017750564865
  - m_Id: 10133612170985472
    m_Localized: Harte Feinde
    m_Metadata:
      m_Items: []
  - m_Id: 10133746195775488
    m_Localized: "* {AffectPrecent} % der Feinde sterben nicht, nachdem sie {ToughLifetime}
      Sekunden lang t\xF6dlichen Schaden erlitten haben"
    m_Metadata:
      m_Items:
      - rid: 569246017750564865
  - m_Id: 10464557839302656
    m_Localized: Adrenalin
    m_Metadata:
      m_Items: []
  - m_Id: 10476504211144704
