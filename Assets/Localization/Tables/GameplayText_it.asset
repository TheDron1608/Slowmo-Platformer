  m_TableData:
  - m_Id: 5406695424
    m_Localized: Muovi
    m_Metadata:
      m_Items: []
  - m_Id: 7130554368
    m_Localized: Salta
    m_Metadata:
      m_Items: []
  - m_Id: 9286426624
    m_Localized: Attacca
    m_Metadata:
      m_Items: []
  - m_Id: 14206345216
    m_Localized: Interagisci
    m_Metadata:
      m_Items: []
  - m_Id: 27481317376
    m_Localized: Afferra/Lancia
    m_Metadata:
      m_Items: []
  - m_Id: 28043354112
    m_Localized: 'Rotola '
    m_Metadata:
      m_Items: []
  - m_Id: 21693710516346880
    m_Localized: "Tieni premuto per saltare pi\xF9 in alto\n\nPremi due volte per
      fare un doppio salto"
    m_Metadata:
      m_Items: []
  - m_Id: 21719977978486784
    m_Localized: 'Non puoi attaccare senza un''arma



      Raccogli la pistola
      e uccidi il nemico per continuare'
    m_Metadata:
      m_Items: []
  - m_Id: 21722062933450752
    m_Localized: Getta la chiave nella porta per continuare
    m_Metadata:
      m_Items: []
  - m_Id: 21722205636255744
    m_Localized: "Abbatti il \u200B\u200Bnemico con un tiro per continuare"
    m_Metadata:
      m_Items: []
  - m_Id: 23552175786418176
    m_Localized: "Abilit\xE0 speciale"
    m_Metadata:
      m_Items: []
  - m_Id: 23552505035087872
    m_Localized: "L'uso dell'abilit\xE0 speciale ti consente di portare la tua arma
      sulla schiena o di toglierla.\nL'abilit\xE0 speciale pu\xF2 cambiare man mano
      che il gioco avanza."
    m_Metadata:
      m_Items: []
  - m_Id: 23552266043645952
    m_Localized: Metti la tua arma sulla schiena per continuare.
    m_Metadata:
      m_Items: []
  - m_Id: 21722610667610112
    m_Localized: "Uccidi i nemici per guadagnare punti combo\n\n\nSuccessivamente,
      i punti combo possono essere scambiati con modificatori\n\n\nRaggiungi la porta
      rossa uccidendo quanti pi\xF9 nemici possibile lungo il percorso"
    m_Metadata:
      m_Items: []
  - m_Id: 21763017808011264
    m_Localized: Hai ricevuto un modificatore negativo; per scambiarlo con uno benefico,
      portalo alla porta verde
    m_Metadata:
      m_Items: []
  - m_Id: 21763598907858944
    m_Localized: "Il gioco diventer\xE0 pi\xF9 difficile ogni 3 minuti, costringendoti
      a scegliere modificatori che non possono essere scambiati.\nDevi sopravvivere
      per 15 minuti. Puoi monitorare i tuoi progressi nell'angolo sinistro. Il tempo
      \xE8 congelato durante il tutorial."
    m_Metadata:
      m_Items: []
  - m_Id: 21764450431262720
    m_Localized: 'Puoi visualizzare le informazioni sui modificatori attuali mettendo
      in pausa il gioco



      Apri il menu di pausa e passa il mouse sull''icona
      del modificatore per continuare'
    m_Metadata:
      m_Items: []
  - m_Id: 24219064862760960
    m_Localized: "Salto rotolante\n\nPuoi saltare durante un rotolamento, il che
      fornir\xE0 un significativo aumento di velocit\xE0"
    m_Metadata:
      m_Items: []
  - m_Id: 21765088586227712
    m_Localized: 'Formazione completata


      Raccogli la granata del teletrasporto
      e attivala per teletrasportarti nel gioco reale :)'
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
