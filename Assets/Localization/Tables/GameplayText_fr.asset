  m_TableData:
  - m_Id: 5406695424
    m_Localized: "D\xE9placer"
    m_Metadata:
      m_Items: []
  - m_Id: 7130554368
    m_Localized: Sauter
    m_Metadata:
      m_Items: []
  - m_Id: 9286426624
    m_Localized: Attaque
    m_Metadata:
      m_Items: []
  - m_Id: 14206345216
    m_Localized: Interagir
    m_Metadata:
      m_Items: []
  - m_Id: 27481317376
    m_Localized: Saisir/Lancer
    m_Metadata:
      m_Items: []
  - m_Id: 28043354112
    m_Localized: 'Rouler '
    m_Metadata:
      m_Items: []
  - m_Id: 21693710516346880
    m_Localized: 'Maintenez pour sauter plus haut


      Appuyez deux fois pour
      faire un double saut'
    m_Metadata:
      m_Items: []
  - m_Id: 21719977978486784
    m_Localized: 'Vous ne pouvez pas attaquer sans arme



      Prenez le pistolet
      et tuez l''ennemi pour continuer'
    m_Metadata:
      m_Items: []
  - m_Id: 21722062933450752
    m_Localized: "Jetez la cl\xE9 dans la porte pour continuer"
    m_Metadata:
      m_Items: []
  - m_Id: 21722205636255744
    m_Localized: Renversez l'ennemi avec un jet pour continuer
    m_Metadata:
      m_Items: []
  - m_Id: 23552175786418176
    m_Localized: "Capacit\xE9 sp\xE9ciale"
    m_Metadata:
      m_Items: []
  - m_Id: 23552505035087872
    m_Localized: "L'utilisation de la capacit\xE9 sp\xE9ciale vous permet de mettre
      votre arme sur votre dos ou de l'enlever.\nLa capacit\xE9 sp\xE9ciale peut
      changer \xE0 mesure que le jeu progresse."
    m_Metadata:
      m_Items: []
  - m_Id: 23552266043645952
    m_Localized: Jetez votre arme sur votre dos pour continuer.
    m_Metadata:
      m_Items: []
  - m_Id: 21722610667610112
    m_Localized: "Tuez des ennemis pour gagner des points de combo\n\n\nPlus tard,
      les points de combo pourront \xEAtre \xE9chang\xE9s contre des modificateurs\n\n\nAtteignez
      la porte rouge en tuant autant d'ennemis que possible en cours de route"
    m_Metadata:
      m_Items: []
  - m_Id: 21763017808011264
    m_Localized: "Vous avez re\xE7u un modificateur n\xE9gatif\_; pour l'\xE9changer
      contre un b\xE9n\xE9fique, portez-le jusqu'\xE0 la porte verte"
    m_Metadata:
      m_Items: []
  - m_Id: 21763598907858944
    m_Localized: "Le jeu deviendra plus difficile toutes les 3 minutes, vous obligeant
      \xE0 choisir des modificateurs qui ne peuvent pas \xEAtre \xE9chang\xE9s.\nVous
      devez survivre pendant 15 minutes. Vous pouvez suivre vos progr\xE8s dans le
      coin gauche. Le temps est fig\xE9 pendant le tutoriel."
    m_Metadata:
      m_Items: []
  - m_Id: 21764450431262720
    m_Localized: "Vous pouvez afficher des informations sur les modificateurs actuels
      en mettant le jeu en pause\n\n\nOuvrez le menu pause et survolez l'ic\xF4ne
      du modificateur pour continuer"
    m_Metadata:
      m_Items: []
  - m_Id: 24219064862760960
    m_Localized: "Saut en roulis\n\nVous pouvez sauter pendant un tonneau, ce qui
      augmentera consid\xE9rablement votre vitesse."
    m_Metadata:
      m_Items: []
  - m_Id: 21765088586227712
    m_Localized: "Formation termin\xE9e\n\nRamassez la grenade t\xE9l\xE9porteuse
      et activez-la pour vous t\xE9l\xE9porter dans le jeu r\xE9el :)"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
