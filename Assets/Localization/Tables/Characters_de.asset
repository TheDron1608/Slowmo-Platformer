  m_SharedData: {fileID: 11400000, guid: 7ceda435e9d75874db4627ac1b530e06, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 22641606656
    m_Localized: Regeneration
    m_Metadata:
      m_Items: []
  - m_Id: 832393936896
    m_Localized: "* St\xE4ndige Regeneration\n* 10 % Zeitdilatation\n* Beginnt mit
      einer Pistole mit Schalld\xE4mpfer\n* F\xFCr Anf\xE4nger"
    m_Metadata:
      m_Items: []
  - m_Id: 1526823878656
    m_Localized: Vampirismus
    m_Metadata:
      m_Items: []
  - m_Id: 1845347713024
    m_Localized: "* T\xF6ten heilt\n* Verz\xF6gerter Tod\n* Beginnt mit einer Kettens\xE4ge"
    m_Metadata:
      m_Items: []
  - m_Id: 48744895267184640
    m_Localized: Unbewaffnet
    m_Metadata:
      m_Items: []
  - m_Id: 48744896659693568
    m_Localized: "* Das Zerst\xF6ren von Waffen heilt\n* Kann niedergeschlagene Gegner
      erledigen\n* Keine Waffen"
    m_Metadata:
      m_Items: []
  - m_Id: 61604093885652992
    m_Localized: "\rHeben Sie jede Art von normaler Waffe mindestens einmal auf"
    m_Metadata:
      m_Items: []
  - m_Id: 59583129123528704
    m_Localized: Schwert
    m_Metadata:
      m_Items: []
  - m_Id: 59583130268573696
    m_Localized: "\r* Du bist ein Schwert\r\n* Das Schwert kann Feinde auf deine
      Seite ziehen\r\n* Du lebst, solange es mindestens einen lebenden konvertierten
      Charakter gibt, der in der Lage ist, ein Schwert zu f\xFChren."
    m_Metadata:
      m_Items: []
  - m_Id: 61604043935686656
    m_Localized: "T\xF6te 100 Feinde in einem Lauf."
    m_Metadata:
      m_Items: []
  - m_Id: 59974664512053248
    m_Localized: Glaskanone
    m_Metadata:
      m_Items: []
  - m_Id: 59974665178947584
    m_Localized: "\r* Sie weichen Projektilen aus, w\xE4hrend Sie eine Combo haben\r\n*
      Du stirbst mit einem Schlag\r\n* Du stirbst, wenn dein Combo-Z\xE4hler zu niedrig
      sinkt\n* Beginnen Sie mit einem Magnum"
    m_Metadata:
      m_Items: []
  - m_Id: 61604006723821568
    m_Localized: "\rErreiche Combo 10"
    m_Metadata:
      m_Items: []
  - m_Id: 60875014270066688
    m_Localized: Sammler
    m_Metadata:
      m_Items: []
  - m_Id: 60875015016652800
    m_Localized: "* Kann Combo gegen Artefakte eintauschen\n* Artefakte heilen den
      Spieler, machen das Spiel jedoch schwieriger\n* Unbegrenzte maximale Gesundheit\n*
      Es k\xF6nnen keine positiven Modifikatoren empfangen werden\n* Beginnt mit
      einer Doppelsense"
    m_Metadata:
      m_Items: []
  - m_Id: 61604002512740352
    m_Localized: 'Verkaufe gleichzeitig Modifikatoren im Gesamtwert von 150 oder
      mehr '
    m_Metadata:
      m_Items: []
  - m_Id: 95151248678838272
    m_Localized: Telekinese
    m_Metadata:
      m_Items: []
  - m_Id: 95151249337344000
    m_Localized: "* Kann keine Waffen aufnehmen\n* Zieht Waffen in der N\xE4he an;
      kann bis zu 4 Waffen aufnehmen\n* Anstatt Schaden zu erleiden, l\xE4sst er
      die Waffe fallen; stirbt, wenn er unbewaffnet Schaden erleidet"
    m_Metadata:
      m_Items: []
  - m_Id: 95312214281658368
    m_Localized: "\xDCberlebe 6 Minuten lang"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
