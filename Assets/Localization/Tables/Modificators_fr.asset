      m_Items:
      - rid: 569246017750564864
  - m_Id: 10133043029098496
    m_Localized: "D\xE9c\xE8s retard\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 10133461012463616
    m_Localized: "* Le joueur ne mourra pas apr\xE8s avoir subi des d\xE9g\xE2ts
