    m_Metadata:
      m_Items: []
  - m_Id: 48744896659693568
    m_Localized: "* \uBB34\uAE30\uB97C \uD30C\uAD34\uD558\uBA74 \uCE58\uC720\uB429\uB2C8\uB2E4.\n*
      \uC4F0\uB7EC\uC9C4 \uC801\uC744 \uB9C8\uBB34\uB9AC\uD560 \uC218 \uC788\uC74C\n*
