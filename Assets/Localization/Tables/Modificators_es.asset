      m_Items:
      - rid: 569246017750564870
  - m_Id: 15564735306940416
    m_Localized: Fusible complicado
    m_Metadata:
      m_Items: []
  - m_Id: 15564736313573376
    m_Localized: '* Las armas arrojadizas a veces se disparan solas.'
