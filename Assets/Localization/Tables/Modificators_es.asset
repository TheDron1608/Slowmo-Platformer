      m_Items:
      - rid: 569246017750564870
  - m_Id: 12671274299834368
    m_Localized: "Doble munici\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 12671276782862336
    m_Localized: "* Cantidad de munici\xF3n x{AmmoMultiplierPrecent}%\n\r* No afecta
      el tama\xF1o de la revista."
    m_Metadata:
      m_Items:
      - rid: 569246017750564870
  - m_Id: 12671773786914816
    m_Localized: "Media munici\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 12671776035061760
    m_Localized: "* La cantidad de munici\xF3n para armas disminuye un {AmmoMultiplierPrecent}%
      cuando la recoge el jugador\n* No afecta a la munici\xF3n cargada."
    m_Metadata:
      m_Items:
      - rid: 569246017750564870
  - m_Id: 12672292941086720
    m_Localized: "Munici\xF3n infinita"
    m_Metadata:
      m_Items: []
  - m_Id: 12672297739370496
    m_Localized: "* {AffectChance}% de las armas tienen munici\xF3n infinita\n* No
      afecta el tama\xF1o de la revista."
    m_Metadata:
      m_Items:
      - rid: 569246017750564870
  - m_Id: 12683894071377920
    m_Localized: revista resbaladiza
    m_Metadata:
      m_Items: []
  - m_Id: 12683896051089408
    m_Localized: '* El jugador siempre toma el arma descargada.

      *Permanecen
      balas descargadas'
    m_Metadata:
      m_Items:
      - rid: 569246017750564870
  - m_Id: 13013170536726528
    m_Localized: Medianoche
    m_Metadata:
      m_Items: []
  - m_Id: 13013171404947456
    m_Localized: "* Sin luz solar\n* Luz tenue de las l\xE1mparas.\n* Linterna de
      armas a distancia habilitada"
    m_Metadata:
      m_Items: []
  - m_Id: 13013254284394496
    m_Localized: Oscuridad total
    m_Metadata:
      m_Items: []
  - m_Id: 13013258482892800
    m_Localized: "* Sin luz solar ni l\xE1mparas.\n* Linterna de armas a distancia
      habilitada"
    m_Metadata:
      m_Items: []
  - m_Id: 13031570667356160
    m_Localized: "ba\xF1o de sangre"
    m_Metadata:
      m_Items: []
  - m_Id: 13031572605124608
    m_Localized: "* M\xE1s sangre"
    m_Metadata:
      m_Items: []
  - m_Id: 13031622836109312
    m_Localized: jones
    m_Metadata:
      m_Items: []
  - m_Id: 13031624207646720
    m_Localized: '* 500% sangre'
    m_Metadata:
      m_Items: []
  - m_Id: 13031824158507008
    m_Localized: Modo transmisor
    m_Metadata:
      m_Items: []
  - m_Id: 13031826008195072
    m_Localized: '* Sin sangre'
    m_Metadata:
      m_Items: []
  - m_Id: 13048572165373952
    m_Localized: Sin cuerpo a cuerpo
    m_Metadata:
      m_Items: []
  - m_Id: 13048574451269632
    m_Localized: '* El arma se rompe cuando el jugador la recoge.'
    m_Metadata:
      m_Items: []
  - m_Id: 13135874124652544
    m_Localized: Sin armas de fuego
    m_Metadata:
      m_Items: []
  - m_Id: 13135875512967168
    m_Localized: '* El personaje descarga un arma de fuego cuando la recoge.'
    m_Metadata:
      m_Items: []
  - m_Id: 13587534982651904
    m_Localized: pergamino misterioso
    m_Metadata:
      m_Items: []
  - m_Id: 13587536186417152
    m_Localized: '* El jugador refleja las balas sin tener nada en sus manos.'
    m_Metadata:
      m_Items: []
  - m_Id: 14153455493160960
    m_Localized: "solo un rasgu\xF1o"
    m_Metadata:
      m_Items: []
  - m_Id: 14153457086996480
    m_Localized: "* Perder la cabeza no es letal para los enemigos.\n* Sin bonificaci\xF3n
      de da\xF1o al disparar a la cabeza"
    m_Metadata:
      m_Items: []
  - m_Id: 14244098722734080
    m_Localized: Segundo respiro
    m_Metadata:
      m_Items: []
  - m_Id: 14244100413038592
    m_Localized: '* Un enemigo muerto tiene una probabilidad de resucitar con un
