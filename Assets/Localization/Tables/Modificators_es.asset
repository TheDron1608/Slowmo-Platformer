      m_Items:
      - rid: 569246017750564870
  - m_Id: 15570870122463232
    m_Localized: Caos de armas
    m_Metadata:
      m_Items: []
  - m_Id: 15570871095541760
    m_Localized: '* Las armas arrojadizas atacan constantemente.'
    m_Metadata:
      m_Items: []
  - m_Id: 15577566102306816
    m_Localized: "Analg\xE9sicos"
    m_Metadata:
      m_Items: []
  - m_Id: 15577568048463872
    m_Localized: "* Los enemigos ya no reciben aturdimiento al recibir da\xF1o."
    m_Metadata:
      m_Items: []
  - m_Id: 15578027106648064
    m_Localized: "C\xF3ctel de combate"
    m_Metadata:
      m_Items: []
  - m_Id: 15578090155425792
    m_Localized: '* Los enemigos no pueden ser aturdidos ni derribados.'
