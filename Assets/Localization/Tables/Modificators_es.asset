    m_Metadata:
      m_Items:
      - rid: 569246017750564870
  - m_Id: 10899584603889664
    m_Localized: "\xA1Ups! Todos los bordes..."
    m_Metadata:
      m_Items: []
  - m_Id: 10899604124180480
    m_Localized: '* Multiplica la probabilidad de que ocurran todos los eventos negativos
