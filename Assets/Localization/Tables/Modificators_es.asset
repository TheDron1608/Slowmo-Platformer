  - m_Id: 11025033094995968
    m_Localized: Alucinaciones
    m_Metadata:
      m_Items: []
  - m_Id: 11025036056174592
    m_Localized: "* La percepci\xF3n del nivel est\xE1 distorsionada."
    m_Metadata:
      m_Items:
      - rid: 569246017750564870
  - m_Id: 11025056717316096
    m_Localized: "Da\xF1o cerebral"
    m_Metadata:
      m_Items: []
  - m_Id: 11025058315345920
    m_Localized: "* La orientaci\xF3n por nivel es casi imposible."
    m_Metadata:
      m_Items:
      - rid: 569246017750564870
  - m_Id: 11711268503396352
    m_Localized: Armadura incompleta
    m_Metadata:
      m_Items: []
  - m_Id: 11711535139495936
    m_Localized: '* El {AffectPrecent}% de los enemigos usan casco o chaleco antibalas'
    m_Metadata:
      m_Items:
      - rid: 569246017750564870
  - m_Id: 11711556018741248
    m_Localized: Armadura
    m_Metadata:
      m_Items: []
  - m_Id: 11711823313346560
    m_Localized: '* El {AffectPrecent}% de los enemigos usan un conjunto completo
      de armadura ligera.'
    m_Metadata:
      m_Items:
      - rid: 569246017750564870
  - m_Id: 11711990871597056
    m_Localized: armadura pesada
    m_Metadata:
      m_Items: []
  - m_Id: 11712265636257792
    m_Localized: '* El {AffectPrecent}% de los enemigos usan un conjunto completo
      de armadura pesada.'
    m_Metadata:
      m_Items:
      - rid: 569246017750564870
  - m_Id: 12297136171270144
    m_Localized: Grandes niveles
    m_Metadata:
      m_Items: []
  - m_Id: 12297139316998144
    m_Localized: "* Tama\xF1o del nivel x{LevelSizeMultPrecent}%"
    m_Metadata:
      m_Items:
      - rid: 569246017750564870
  - m_Id: 12326294859431936
    m_Localized: "giro de c\xE1mara"
    m_Metadata:
      m_Items: []
  - m_Id: 12326296491016192
    m_Localized: "* C\xE1mara girada 180 grados"
    m_Metadata:
      m_Items:
      - rid: 569246017750564870
  - m_Id: 12331990384525312
    m_Localized: Mareo
    m_Metadata:
      m_Items: []
  - m_Id: 12331991982555136
    m_Localized: "* La c\xE1mara gira al moverse."
    m_Metadata:
      m_Items:
      - rid: 569246017750564870
  - m_Id: 12332400709091328
    m_Localized: "Disfunci\xF3n vestibular"
    m_Metadata:
      m_Items: []
  - m_Id: 12332402487476224
    m_Localized: "* La c\xE1mara gira mucho al moverse."
    m_Metadata:
      m_Items:
      - rid: 569246017750564870
  - m_Id: 12650826824564736
    m_Localized: Defecto de arma
    m_Metadata:
      m_Items: []
  - m_Id: 12650847825444864
    m_Localized: '* El arma tiene un {JamChancePrecent} % de posibilidades de fallar'
