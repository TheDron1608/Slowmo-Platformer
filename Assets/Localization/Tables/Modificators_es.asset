  - m_Id: 10133043029098496
    m_Localized: Muerte retrasada
    m_Metadata:
      m_Items: []
  - m_Id: 10133461012463616
    m_Localized: "* El jugador no morir\xE1 despu\xE9s de recibir da\xF1o letal durante
