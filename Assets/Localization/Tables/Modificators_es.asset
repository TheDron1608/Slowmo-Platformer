    m_Metadata:
      m_Items:
      - rid: 569246017750564870
  - m_Id: 10899551712157696
    m_Localized: "\xA1Ups! Todos 1..."
    m_Metadata:
      m_Items: []
  - m_Id: 10899570590720000
    m_Localized: '* Multiplica la probabilidad de que ocurran todos los eventos negativos
